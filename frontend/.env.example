# Copy this file to `.env` (or set in your CI) and adjust.

# URL of the ShowPickr backend (Node + Socket.io).
# Leave EMPTY for local dev — Vite proxies /api and /socket.io to the backend,
# so there is no CORS at all. Set it to the full HTTPS URL in production.
VITE_API_URL=

# Override the backend URL that the Vite dev proxy forwards to (local dev only).
VITE_PROXY_TARGET=http://localhost:4000

# Base path for assets. Use "/" locally, and "/<repo-name>/" for GitHub Pages.
VITE_BASE=/
