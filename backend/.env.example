# Copy this file to `.env` and fill in the values.

# SQLite database file (path is relative to the prisma/ directory)
DATABASE_URL=file:./dev.db

# Your MovieOfTheNight API key (https://developers.movieofthenight.com/)
MOTN_API_KEY=

# Port the backend listens on
PORT=4000

# Comma-separated list of allowed CORS origins (use * for local dev)
CORS_ORIGIN=*

# Cache MovieOfTheNight responses to disk (avoid burning free-tier quota).
# Defaults to ON in development, OFF in production. Set 0 or 1 to override.
MOTN_CACHE=1
MOTN_CACHE_DIR=.cache
MOTN_CACHE_TTL_SECONDS=604800
