# Caddy reverse proxy for the ShowPickr backend.
# {$SITE_ADDRESS} is injected from the container environment (see docker-compose.yml).
# When it is a real domain (e.g. api.example.com), Caddy automatically obtains and
# renews a Let's Encrypt certificate and redirects HTTP -> HTTPS.
# Set it to ":80" to serve plain HTTP without a domain (local/IP testing only).

{$SITE_ADDRESS} {
	encode gzip
	reverse_proxy backend:4000
}
